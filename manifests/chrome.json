{
    "manifest_version": 3,
    "name": "Hack LMS",
    "description": "Utilies for SSU LMS",
    "icons": {
        "128": "images/canvas.png"
    },
    "permissions": [
        "scripting",
        "downloads",
        "declarativeNetRequest",
        "webRequest",
        "storage"
    ],
    "host_permissions": [
        "*://canvas.ssu.ac.kr/*",
        "*://*.commonscdn.com/*",
        "*://commons.ssu.ac.kr/*"
    ],
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "content_scripts": [
        {
            "matches": ["https://commons.ssu.ac.kr/*"],
            "js": ["src/platform.js", "src/video-iframe-listener.js"],
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "src/background.js"
    }
}
